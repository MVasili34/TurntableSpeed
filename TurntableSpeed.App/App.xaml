<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:TurntableSpeed.App.Converters"
             x:Class="TurntableSpeed.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:NoticeLevelToColorConverter x:Key="NoticeColor" />

            <!-- Surface / Panel / Ink / Muted / Accent live in Resources/Styles/Colors.xaml. -->

            <Style x:Key="Screen" TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Panel}" />
                <Setter Property="Stroke" Value="{StaticResource PanelStroke}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            </Style>

            <Style x:Key="Reading" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Ink}" />
                <Setter Property="FontSize" Value="46" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="LineBreakMode" Value="NoWrap" />
            </Style>

            <Style x:Key="Caption" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Muted}" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="Value" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Ink}" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Accent}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="Chart" TargetType="GraphicsView">
                <Setter Property="HeightRequest" Value="150" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

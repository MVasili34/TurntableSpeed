<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:TurntableSpeed.App.Localization"
             x:Class="TurntableSpeed.App.Views.SensorModePage"
             Style="{StaticResource Screen}"
             Title="{loc:Translate TabSensors}">

    <!--
        The language toggle is on every screen: a setting you have to go looking for is one the
        user has to leave the measurement to reach. The static Instance is how a ToolbarItem
        gets at a view model at all — it has no binding context of its own.
    -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding ToggleLabel, Source={x:Static loc:LanguageViewModel.Instance}}"
                     Command="{Binding ToggleCommand, Source={x:Static loc:LanguageViewModel.Instance}}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="12">

            <!-- Headline reading: value, interval, nominal, deviation. -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="End">
                        <Label Style="{StaticResource Reading}" Text="{Binding Speed.Rpm}" />
                        <Label Style="{StaticResource Caption}" Text="{loc:Translate UnitRpm}"
                               VerticalOptions="End" Margin="0,0,0,12" />
                    </HorizontalStackLayout>

                    <Label Style="{StaticResource Value}" Text="{Binding Speed.Interval95}" />

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,4,0,0">
                        <Label Grid.Column="0" Style="{StaticResource SectionTitle}"
                               FontSize="20" Text="{Binding Speed.Nominal}" />
                        <Label Grid.Column="1" Style="{StaticResource Value}"
                               Text="{Binding Speed.DeviationPercent}" />
                        <Label Grid.Column="2" Style="{StaticResource Value}"
                               Text="{Binding Speed.DeviationCents}" />
                    </Grid>

                    <ProgressBar Progress="{Binding Speed.Confidence}" ProgressColor="{StaticResource Accent}" />
                    <Label Style="{StaticResource Caption}" Text="{Binding Speed.ConfidenceLabel}" />
                </VerticalStackLayout>
            </Border>

            <!-- Controls. -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="{loc:Translate ButtonStart}" Command="{Binding StartCommand}" />
                        <Button Grid.Column="1" Text="{loc:Translate ButtonStop}" Command="{Binding StopCommand}" />
                        <Button Grid.Column="2" Text="{loc:Translate ButtonReset}" Command="{Binding ResetCommand}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource PanelStroke}" />

                    <Label Style="{StaticResource SectionTitle}" Text="{loc:Translate SensorSectionZero}" />
                    <Label Style="{StaticResource Caption}" Text="{loc:Translate SensorZeroHint}" />
                    <Button Text="{loc:Translate SensorZeroButton}" Command="{Binding CalibrateZeroCommand}" />
                    <ProgressBar Progress="{Binding ZeroProgress}" ProgressColor="{StaticResource Accent}" />
                    <Label Style="{StaticResource Value}" Text="{Binding ZeroStatus}" />
                </VerticalStackLayout>
            </Border>

            <!-- Instantaneous rate over time. -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource SectionTitle}" Text="{loc:Translate SensorSectionInstant}" />
                    <Label Style="{StaticResource Value}" Text="{Binding InstantaneousRpm}" />
                    <GraphicsView x:Name="RateChart" Style="{StaticResource Chart}" />
                </VerticalStackLayout>
            </Border>

            <!-- Wow and flutter. -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource SectionTitle}" Text="{loc:Translate SensorSectionWow}" />
                    <Label Style="{StaticResource Value}" Text="{Binding WowSummary}" />
                    <GraphicsView x:Name="WowChart" Style="{StaticResource Chart}" />
                    <Label Style="{StaticResource Caption}" Text="{loc:Translate SensorWowHint}" />
                </VerticalStackLayout>
            </Border>

            <!-- Secondary readings. -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource SectionTitle}" Text="{loc:Translate SectionState}" />

                    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                        <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource Caption}" Text="{loc:Translate LabelDisagreement}" />
                        <Label Grid.Row="0" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Disagreement}" />

                        <Label Grid.Row="1" Grid.Column="0" Style="{StaticResource Caption}" Text="{loc:Translate LabelOrientation}" />
                        <Label Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Orientation}" />

                        <Label Grid.Row="2" Grid.Column="0" Style="{StaticResource Caption}" Text="{loc:Translate LabelSpinUp}" />
                        <Label Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding SpinUp}" />

                        <Label Grid.Row="3" Grid.Column="0" Style="{StaticResource Caption}" Text="{loc:Translate LabelGyroScale}" />
                        <Label Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding GyroScaleFactor}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Warnings, including the mandatory one about the phone's own weight. -->
            <CollectionView ItemsSource="{Binding Notices}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="4,*" ColumnSpacing="12">
                                <BoxView Grid.Column="0"
                                         Color="{Binding Level, Converter={StaticResource NoticeColor}}"
                                         CornerRadius="2" />
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Style="{StaticResource Value}" FontAttributes="Bold" Text="{Binding Title}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Detail}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
